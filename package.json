{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Temporal-orchestrated hotel offer aggregation with Redis price filtering",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "start:render": "node dist/render.js",
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts"
  },
  "dependencies": {
    "@temporalio/client": "^1.11.8",
    "@temporalio/worker": "^1.11.8",
    "@temporalio/workflow": "^1.11.8",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.2",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
