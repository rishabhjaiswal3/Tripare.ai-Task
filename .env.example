# Copy to .env for local development. Render dashboard variables are configured separately.
NODE_ENV=production
PORT=3000
API_PORT=3000
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
REDIS_URL=redis://127.0.0.1:6379
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=hotel-offer-task-queue
# Temporal Cloud only: set both to enable TLS + API key auth. Leave empty for local Temporal.
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
SUPPLIER_A_URL=http://localhost:3000/supplierA/hotels
SUPPLIER_B_URL=http://localhost:3000/supplierB/hotels

# Docker Compose uses container-to-container addresses, distinct from local host addresses above.
COMPOSE_REDIS_URL=redis://redis:6379
COMPOSE_TEMPORAL_ADDRESS=temporal:7233
COMPOSE_SUPPLIER_A_URL=http://api:3000/supplierA/hotels
COMPOSE_SUPPLIER_B_URL=http://api:3000/supplierB/hotels
